# Chrony configuration for a client of this box.
#
# No `prefer`: the box once served 134 ms of wrong time for hours while
# claiming 2.4 us, and without `prefer` chrony can outvote it.
#
# Named, not addressed, so an address change does not leave the client stale;
# the domain comes from the resolver's search list.
#
# `xleave` (RFC 9769 interleaved mode) makes chrony use the MAC-measured
# transmit timestamp of the previous reply. Without it the transmit field is
# written before the frame leaves, which showed as an 85 us bias on a test
# client. The box falls back to basic replies when it has lost the exchange;
# `chronyc ntpdata <addr>` shows `Interleaved: yes`, and the box counts them in
# `ntp_interleaved_served`.

server esp32p4-ntp iburst minpoll 4 maxpoll 6 xleave

# Fallbacks, polled every 32 s or slower.
pool 2.debian.pool.ntp.org iburst minpoll 5 maxpoll 7
server time.cloudflare.com iburst minpoll 5 maxpoll 7
server time.apple.com      iburst minpoll 5 maxpoll 7

# Step only for gross errors.
makestep 1.0 3

maxdistance 16.0

driftfile /var/lib/chrony/chrony.drift
