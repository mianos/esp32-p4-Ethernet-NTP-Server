CONFIG_IDF_TARGET="esp32p4"

# The Waveshare ESP32-P4-ETH carries 32 MB of flash; this demo uses ~1 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# Console/logs on UART0. The board's USB-C port is a CH343 USB-UART bridge
# (VID 0x1A86, PID 0x55D3, CDC-ACM -> /dev/ttyACM*), wired to the P4's UART0. It
# is the same port esptool flashes over, so one cable does both -- which is also
# why the console REPL lives there: it is the only reachable port.
# (The P4's native USB-Serial/JTAG is *not* on that connector: there is no 303a
# device on the bus, only the 1a86 one.)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Two 1.7 MB app slots instead of one factory slot. The box is headless and its
# only interface is the Ethernet port, so the way to update it in the field is
# POST /firmware; that needs a second slot to write into. The app is ~0.5 MB of
# a 32 MB part, so the spare slot costs nothing. nvs stays at 0x9000 in both
# layouts, so settings survive the one-off USB reflash that installs this table.
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# An OTA'd image boots as ESP_OTA_IMG_PENDING_VERIFY and the bootloader drops
# back to the previous slot unless the app confirms itself; main.cpp does that
# once it has a lease and a listening HTTP server. Without this, an image that
# breaks the network would need a USB cable to recover.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# IPv6 on the RJ45, alongside IPv4 rather than instead of it. lwIP in IDF 6 is
# built with IPv6 on by default, but that alone leaves the netif with no IPv6
# address at all: SLAAC is off, and esp_netif only creates the fe80:: link-local
# when the application asks (main.cpp does, on every link-up). With SLAAC on,
# the board also takes a global address from the router's advertisements.
# Everything above lwIP is already dual-stack -- esp_http_server binds
# in6addr_any -- so /healthz, /config and POST /firmware answer over either
# family without the handlers knowing. DHCPv6 stays off: SLAAC covers a normal
# LAN, and the option-42 clock source is IPv4-only regardless, because RFC 2132
# defines it as a list of IPv4 addresses.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# MLD is what makes the board join the all-nodes multicast group, and without it
# it hears no router advertisement: the link-local is created, the Solicitation
# is answered only by accident, and the board sits there IPv6-less while its
# neighbour on the same bridge autoconfigures in eight seconds. Off by default
# in lwIP, and the reason an earlier note claimed SLAAC "just works".
CONFIG_LWIP_IPV6_MLD=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=3

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Test-mode clock: ask the DHCP server for an NTP server (option 42) and poll it
# with lwIP's SNTP client, so /healthz and the NTP responder have real time to
# work with. Two slots each, because a lease may carry a primary and a backup.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=2
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# The DHCP request has to carry the hostname twice (option 12, and ESP-IDF's
# vendor-class-identifier hook falls back to it), plus the client id: the option
# area needs 41 + 2*strlen(hostname) bytes. The default 69 (used when
# LWIP_DHCP_DISABLE_VENDOR_CLASS_ID is on) fits a 14-character name, so anything
# longer makes lwIP drop an option and print an LWIP_ERROR at every boot --
# which is what a 32-character hostname (Settings::kMaxHostnameLen) does.
CONFIG_LWIP_DHCP_OPTIONS_LEN=128

# std::format in a handler costs several hundred bytes of frame each;
# 4 KB (the component default) overflows on the JSON builders.
CONFIG_WEBSERVER_TASK_STACK_SIZE=12288

# The system event task runs the netif event handlers, and those log with
# std::string and start the servers. At the 2304 default a Status copy on that
# task overflowed its canary and panicked the board on every boot, which only
# showed as a 10-second DHCP loop. 4 KB leaves room for the handlers and the
# float parsing they do.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144

# The PPS edge is a capture interrupt and must survive the flash cache
# going away under an OTA write, as the old GPIO interrupt did.
CONFIG_MCPWM_ISR_CACHE_SAFE=y
CONFIG_MCPWM_CTRL_FUNC_IN_IRAM=y

# The status poller holds connections open and the transmit probe takes a
# socket every five seconds; ten is not enough for a listen backlog plus
# both, and the httpd then fails to accept with ENFILE every couple of
# seconds. Requests still succeed on the retry, so it read as log noise
# rather than the shortage it is.
CONFIG_LWIP_MAX_SOCKETS=16

# `tasks` in the console needs both; nothing else in the firmware does.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# lwIP, the NTP responder's raw replies and the PTP task all transmit, from
# three tasks on two cores, and the EMAC's descriptor ring has no lock of its
# own.
CONFIG_ETH_TRANSMIT_MUTEX=y
