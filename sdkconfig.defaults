CONFIG_IDF_TARGET="esp32p4"

# The Waveshare ESP32-P4-ETH carries 32 MB of flash; this demo uses ~1 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# Console/logs on UART0. The board's USB-C port is a CH343 USB-UART bridge
# (VID 0x1A86, PID 0x55D3, CDC-ACM -> /dev/tty.usbmodem*), wired to the P4's
# UART0. It is the same port esptool flashes over, so one cable does both.
# (The P4's native USB-Serial/JTAG is *not* on that connector.)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Two 1.7 MB app slots instead of one factory slot. The box is headless and its
# only interface is the Ethernet port, so the way to update it in the field is
# POST /firmware; that needs a second slot to write into. The app is ~0.5 MB of
# a 32 MB part, so the spare slot costs nothing. nvs stays at 0x9000 in both
# layouts, so settings survive the one-off USB reflash that installs this table.
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# An OTA'd image boots as ESP_OTA_IMG_PENDING_VERIFY and the bootloader drops
# back to the previous slot unless the app confirms itself; main.cpp does that
# once it has a lease and a listening HTTP server. Without this, an image that
# breaks the network would need a USB cable to recover.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Test-mode clock: ask the DHCP server for an NTP server (option 42) and poll it
# with lwIP's SNTP client, so /healthz and the NTP responder have real time to
# work with. Two slots each, because a lease may carry a primary and a backup.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=2
CONFIG_LWIP_SNTP_MAX_SERVERS=2
